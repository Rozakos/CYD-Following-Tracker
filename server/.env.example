# Copy to server/.env and fill in -- never commit .env
# Bearer token the device sends (Settings -> API token on the CYD web admin).
API_SECRET=changeme

# YouTube Data API v3 key (console.cloud.google.com -> APIs & Services ->
# enable "YouTube Data API v3" -> Credentials -> API key). Free quota is 10,000
# units/day; each lookup costs 1, so polling 20 channels hourly uses ~480/day.
YOUTUBE_API_KEY=

# Twitch app (dev.twitch.tv/console/apps -> Register, OAuth redirect http://localhost,
# category "Other"). Client-credentials only, no user login needed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Fake "demo" platform with a year of synthetic history, to try the device
# before you have keys. Any handle works.
SOCIAL_DEMO=1

# Optional (defaults shown)
# API_PREFIX=/social/api/v1
# CACHE_TTL_SECONDS=600          # live counts cached per account
# POLL_SECONDS=3600              # background refresh of recently requested accounts (0 = off)
# ACTIVE_DAYS=14                 # keep polling accounts a device asked about within this many days
# SAMPLE_MIN_GAP_SECONDS=900     # at most one stored sample per account per 15 min
# RETENTION_DAYS=1825
# SPARKLINE_POINTS=10            # points in /social "history" (firmware SPARKLINE_POINTS)
# DB_PATH=data/social.db
# ICON_DIR=icons                 # drop <platform>.png here to override the drawn badge
