# Paste inside the existing rozakos.eu HTTPS server block, next to /stocks/api/.

location /social/api/ {
    proxy_pass         http://127.0.0.1:8002/social/api/;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 20s;
}

# Keep the auto-generated docs private
location ~ ^/social/api/v1/(docs|openapi\.json) {
    allow 127.0.0.1;
    deny  all;
}
